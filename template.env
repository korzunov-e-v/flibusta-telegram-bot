# Скопируй в .env и заполни: cp template.env .env

# --- Telegram ---
TOKEN=твой_telegram_token
# id администратора; несколько — через запятую: 111,222
ADMINS=твой_telegram_id

# --- SMTP (отправка книг на почту) ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=твоя_почта@gmail.com
SMTP_PASS=пароль_приложения

# --- PostgreSQL (URL подключения собирается из этих переменных) ---
POSTGRES_DB=flibusta
POSTGRES_USER=flibusta
POSTGRES_PASSWORD=change_me_to_a_strong_password
# В Docker Compose хост и порт для бота задаются в docker-compose.yml (postgres:5432),
# значения ниже нужны только при запуске бота/миграций с хоста.
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# --- Необязательные (указаны значения по умолчанию) ---
# адрес сайта/зеркала Flibusta
#FLIBUSTA_URL=https://flibusta.is
# сколько писем в сутки может отправить один пользователь
#EMAIL_DAILY_LIMIT=10
# каталог с файлом состояния бота; в Docker задаётся в docker-compose.yml (/srv/data)
#DATA_DIR=data
# таймаут SMTP в секундах
#SMTP_TIMEOUT=30
# предельный размер файла, МБ: в чат (лимит Bot API — 50) и на почту
#MAX_CHAT_FILE_MB=50
#MAX_EMAIL_FILE_MB=18
